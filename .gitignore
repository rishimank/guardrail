# --- Secrets / credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem

# --- Python ---
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Model weights (huge; re-downloaded from HuggingFace) ---
