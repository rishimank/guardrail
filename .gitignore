models/
adapters/
*.safetensors
*.gguf

# --- Eval artifacts ---
# The response cache is a local speed/cost optimization, regenerated on demand.
.cache/
# Raw per-run outputs. BENCHMARKS.md is the curated, committed record — not these.
runs/
*.run.json

# --- OS / editor noise ---
.DS_Store
.idea/
.vscode/
