# Copy to .env and fill in. NEVER commit .env (it is gitignored; .env.example is not).
#   cp .env.example .env

# --- Judge (Phase 3+) -------------------------------------------------------
# console.anthropic.com -> API keys. SET A BILLING LIMIT before the first call.
# A full 500-prompt run is ~$1.35 on claude-haiku-4-5.
ANTHROPIC_API_KEY=

# --- Tracing (Phase 4+) -----------------------------------------------------
# smith.langchain.com -> Settings -> API keys. Free tier: 5k traces/month.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=guardrail
# Set to "true" to actually ship traces. Leave false/unset to develop offline.
LANGSMITH_TRACING=false

# --- Knobs ------------------------------------------------------------------
# Which SUT implementation to use: mock | mlx | lora
# "mock" is free/offline/deterministic and is what CI and Docker run.
GUARDRAIL_SUT=mock
JUDGE_MODEL=claude-haiku-4-5
SUT_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
