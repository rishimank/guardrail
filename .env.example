# Copy to .env and fill in. NEVER commit .env (it is gitignored; .env.example is not).
#   cp .env.example .env
#
# NOTHING HERE IS REQUIRED TO RUN THE PROJECT. The default configuration is free and
# offline: MockSUT needs no key, injection/pii grade by verbatim string matching, and
# the gate is arithmetic over committed counts. A key is needed only to (a) grade the
# four judgment categories with the Haiku judge, or (b) synthesize new corpus rows.
# CI and Docker set no key at all — see .github/workflows/ci.yml.

# --- Judge (Phase 3+) -------------------------------------------------------
# console.anthropic.com -> API keys. SET A BILLING LIMIT before the first call.
# A full 662-prompt run is ~$1.35 on claude-haiku-4-5.
ANTHROPIC_API_KEY=

# --- Knobs ------------------------------------------------------------------
# Which SUT implementation to use: mock | mlx | lora
# "mock" is free/offline/deterministic and is what CI and Docker run.
GUARDRAIL_SUT=mock
JUDGE_MODEL=claude-haiku-4-5
SUT_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit

# Server-level kill switch for paid grading, read by the FastAPI service. Paid calls
# need BOTH this AND a per-request use_judge=true, so a demo left running on an open
# port cannot become a billing hole. Left unset (= false) on purpose.
# GUARDRAIL_ALLOW_JUDGE=false

# Fine-tuned adapter to serve when GUARDRAIL_SUT=lora. The checkpoint was selected on
# VALIDATION loss, never on the test split.
# GUARDRAIL_ADAPTER_PATH=adapters/v2
# GUARDRAIL_ADAPTER_CHECKPOINT=125
